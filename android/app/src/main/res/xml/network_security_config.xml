<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration: permit cleartext HTTP so local Wi-Fi dev servers and HTTP radio streams function smoothly -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
